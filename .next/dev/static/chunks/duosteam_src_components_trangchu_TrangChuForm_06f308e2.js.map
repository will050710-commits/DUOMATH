      <AccordionItem key="1" aria-label="User" startContent={
      <Avatar isBordered color="primary" src="/images/defaultuser.png"  style={{ width: 36, height: 36, borderRadius: "50%", flexShrink: 0 }}/>} variant="shadow" >
   <div style={{
