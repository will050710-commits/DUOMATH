        <style jsx>{`
          /* ── Base reveal: slides up + fades in ── */
          .reveal {
            opacity: 0;
            transform: translateY(28px) scale(0.97);
            transition:
              opacity 0.55s cubic-bezier(.2,.8,.2,1),
              transform 0.45s cubic-bezier(.2,.8,.2,1);
            will-change: opacity, transform;
          }
          .reveal.visible {
            opacity: 1;
            transform: translateY(0) scale(1);
          }

          /* ── Stagger parent: becomes visible immediately (children animate individually via JS) ── */
          .reveal[data-reveal-stagger].visible {
            opacity: 1;
            transform: none;
          }

          /* ── Stagger children default (JS overrides with per-child delays) ── */
          .reveal[data-reveal-stagger] > * {
            opacity: 0;
            transform: translateY(24px) scale(0.97);
            will-change: opacity, transform;
          }

          /* ── Header reveal: slides down from top ── */
          header.reveal {
            transform: translateY(-18px);
            opacity: 0;
          }
          header.reveal.visible {
            opacity: 1;
            transform: translateY(0);
          }

          /* ── avatar-triggered accordion animation ── */
          .avatar-accordion {
            opacity: 0;
            transform: translateY(-16px) scale(0.97);
            transition: opacity .45s cubic-bezier(.2,.8,.2,1), transform .4s cubic-bezier(.2,.8,.2,1);
            will-change: opacity, transform;
          }
          .avatar-accordion.avatar-visible {
            opacity: 1;
            transform: translateY(0) scale(1);
          }

          /* ── Dropdown used in header avatar ── */
          .avatar-dropdown {
            position: absolute;
            top: 55px;
            left: 50%;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            opacity: 0;
            transform: translateX(-50%) translateY(-10px) scale(0.96);
            visibility: hidden;
            pointer-events: none;
            transition: all .25s cubic-bezier(.2,.8,.2,1);
            z-index: 100;
          }
          .avatar-dropdown.avatar-visible {
