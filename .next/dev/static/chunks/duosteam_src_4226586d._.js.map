"use client";
import { useEffect, useState } from "react";
import Link from "next/link";
import HeroProvider from "../../../HeroProvider";
import {Accordion, AccordionItem} from "@heroui/react";
import {Avatar} from "@heroui/react";
import DuoMCBSidebar from "../DuoMCB/DuoMCBSidebar";
import { clearTestSession } from "@/utils/testTimer";

export default function TrangChuForm() {
  const [openMenu, setOpenMenu] = useState(false);
  const [showFlyer, setShowFlyer] = useState(false);
  const defaultContent = "📧Gmail: will050710gmail.com\n";
  const [content, setContent] = useState(defaultContent);
  const defaultContent2 = "☎️Phone: +84 336 290 219";
  const [content2, setContent2] = useState(defaultContent2);
  const defaultContent3 = "📍Address: Thpt Nguyễn Chí Thanh";
  const [content3, setContent3] = useState(defaultContent3);

  const defaultContents = [
    "📧Gmail: will050710gmail.com",
    "☎️Phone: +84 336 290 219",
    "📍Address: Thpt Nguyễn Chí Thanh",
  ];
  const [contents, setContents] = useState(defaultContents);

  // ── Flyer step data ──────────────────────────────────────────────────────
  const flyerSteps = [
    {
      icon: "📖",
      title: "Bilingual Lessons",
      color: "#0B4F5C",
      bg: "#e8f4f6",
      steps: [
        'Go to "Học toán" → pick any chapter (Chapters I – X).',
        "Toggle 🇻🇳 / 🇬🇧 to switch the entire lesson between Vietnamese and English instantly — no page reload.",
        "Follow the 5-part structure: Warm-up → Theory cards → Practice (show/hide answers) → Mini-game.",
      ],
    },
    {
      icon: "🤖",
      title: "DuoMCB — AI Chatbot",
      color: "#1a5276",
      bg: "#eaf4fb",
      steps: [
        "Click the floating chat bubble (bottom-right corner of any page).",
        "Type your math question in Vietnamese or English — AI replies in both languages.",
        'Choose "Hint" for step-by-step guidance, or "Answer" for a full worked solution.',
        "Send a photo of a handwritten problem — Vision AI will read and solve it.",
      ],
    },
    {
      icon: "🔍",
      title: "DuoTranslator",
      color: "#1e8449",
      bg: "#eafaf1",
      steps: [
        "Highlight any English word or phrase on a lesson page.",
        "A panel slides up automatically within 1–2 seconds.",
        "Read the Vietnamese translation, plain-language summary, and word-by-word breakdown with IPA pronunciation.",
      ],
    },
    {
      icon: "🎮",
      title: "Mini-Games",
      color: "#7d3c98",
      bg: "#f5eef8",
      steps: [
        "Scroll to the bottom of any lesson to find the Mini-game section.",
        "Pick a mode: 🧩 Multiple Choice (5 Q) · 🃏 True / False (5 cards) · ✍️ Fill in Blank (3 Q).",
        "After finishing, check your ResultSummary — each question shows the correct answer and an explanation.",
        "Hit 🔄 Play Again to retry as many times as you like.",
      ],
    },
    {
      icon: "📝",
      title: "Bilingual Tests",
      color: "#922b21",
      bg: "#fdf2f2",
      steps: [
        "From the home page, click any Test card (Test 1 / Test 2).",
        "Section 1 — SAT Reading (Multiple Choice) · Section 2 — IELTS True/False/NG · Section 3 — Grade 10 Short-answer Math.",
        "All 3 sections share one 60-minute countdown; your answers auto-save when you switch sections.",
        "Click 'Nộp bài' on Section 3 to submit and see your score.",
      ],
    },
  ];

  // ── Scroll-reveal observer ───────────────────────────────────────────────
  useEffect(() => {
    if (typeof window === "undefined") return;
    const els = document.querySelectorAll('[data-reveal]');
    els.forEach((el) => {
      if (el.hasAttribute('data-reveal-stagger')) {
        const stagger = parseInt(el.getAttribute('data-stagger') || '80', 10);
        Array.from(el.children).forEach((child, i) => {
          child.style.opacity = '0';
          child.style.transform = 'translateY(24px) scale(0.97)';
          child.style.transition = `opacity 0.5s cubic-bezier(.2,.8,.2,1) ${i * stagger}ms, transform 0.45s cubic-bezier(.2,.8,.2,1) ${i * stagger}ms`;
          child.style.willChange = 'opacity, transform';
        });
      }
    });
    const obs = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const stagger = parseInt(el.getAttribute('data-stagger') || '80', 10);
            if (el.hasAttribute('data-reveal-stagger')) {
              Array.from(el.children).forEach((child, i) => {
                setTimeout(() => {
                  child.style.opacity = '1';
                  child.style.transform = 'translateY(0) scale(1)';
                }, i * stagger);
              });
            }
            el.classList.add("visible");
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    els.forEach((el) => obs.observe(el));
    return () => obs.disconnect();
  }, []);

  // ── Avatar accordion toggle ──────────────────────────────────────────────
  useEffect(() => {
    if (typeof window === "undefined") return;
    const handler = (ev) => {
      const trigger = ev.target.closest('[data-avatar-trigger]');
      if (!trigger) return;
      const container = trigger.closest('div');
      if (!container) return;
      container.querySelectorAll('[data-avatar-accordion]').forEach((g) => g.classList.toggle('avatar-visible'));
    };
    document.addEventListener('click', handler);
    const closeHandler = (ev) => {
      if (!ev.target.closest('[data-avatar-trigger]') && !ev.target.closest('[data-avatar-accordion]')) {
        document.querySelectorAll('[data-avatar-accordion]').forEach((g) => g.classList.remove('avatar-visible'));
      }
    };
    document.addEventListener('click', closeHandler);
    return () => {
      document.removeEventListener('click', handler);
      document.removeEventListener('click', closeHandler);
    };
  }, []);

  // ── Close flyer on outside click ─────────────────────────────────────────
  useEffect(() => {
    if (!showFlyer) return;
    const handler = (e) => {
      if (!e.target.closest('[data-flyer-root]')) setShowFlyer(false);
    };
    document.addEventListener('mousedown', handler);
    return () => document.removeEventListener('mousedown', handler);
  }, [showFlyer]);

  return (
    <div style={{ width: "100%", background: "#ffffff", display: "flex", justifyContent: "center" }}>
      <div style={{ width: "1200px", maxWidth: "95%", color: "black" }}>

        {/* ================= HEADER ================= */}
        <header className="reveal" data-reveal
          style={{
            display: "flex", justifyContent: "space-between", alignItems: "center",
            padding: "20px 20px", position: "relative", zIndex: 300,
            boxShadow: "0 4px 12px rgba(0,0,0,0.1)",
            background: "linear-gradient(135deg, #00d8fe, #13b0ff)", color: "white",
          }}
        >
          {/* LOGO */}
          <div style={{ fontWeight: "bold", fontSize: 22, color: "#0B4F5C", letterSpacing: 1 }}>
            DUOSTEAM
          </div>

          {/* NAV */}
          <nav style={{ display: "flex", alignItems: "center", gap: 28, fontSize: 16, position: "relative", zIndex: 300 }}>

            {/* Chatbot */}
            <Link href="/DuoMCB" style={{ textDecoration: "none", color: "black", boxShadow: "0 4px 12px rgba(0,0,0,0.1)", padding: "12px 12px", borderRadius: 8, background: "white" }}>
              Chatbot ›
            </Link>

            {/* ── HOW TO USE (replaces Minigame) ──────────────────────────── */}
            <div data-flyer-root style={{ position: "relative" }}>

              {/* Trigger button */}
              <button
                onClick={() => setShowFlyer(v => !v)}
                style={{
                  color: showFlyer ? "white" : "black",
                  boxShadow: "0 4px 12px rgba(0,0,0,0.1)",
                  padding: "12px 14px", borderRadius: 8,
                  background: showFlyer ? "#0B4F5C" : "white",
                  border: "none", fontSize: 15, cursor: "pointer",
                  fontWeight: 500, transition: "all 0.2s",
                  display: "flex", alignItems: "center", gap: 6,
                  whiteSpace: "nowrap",
                }}
              >
                📚 Hướng dẫn {showFlyer ? "▲" : "▼"}
              </button>

              {/* ── FLYER DROPDOWN ── */}
              {showFlyer && (
                <div style={{
                  position: "absolute", top: "calc(100% + 14px)", right: 0,
                  width: 520, maxHeight: "80vh", overflowY: "auto",
                  background: "#fff", borderRadius: 14,
                  boxShadow: "0 24px 64px rgba(0,0,0,0.18)",
                  zIndex: 1000, padding: "22px 22px 18px",
                  border: "1.5px solid #d5eef3",
                }}>

                  {/* ── Header banner ── */}
                  <div style={{
                    background: "linear-gradient(135deg, #0B4F5C 0%, #1a9ab5 100%)",
                    borderRadius: 10, padding: "16px 20px", marginBottom: 16,
                    color: "white", textAlign: "center",
                  }}>
                    <div style={{ fontSize: 20, fontWeight: 800, marginBottom: 3, letterSpacing: 0.3 }}>
                      🎓 DuoMath — Quick Start Guide
                    </div>
                    <div style={{ fontSize: 12, opacity: 0.82, letterSpacing: 0.2 }}>
                      Bilingual Math · AI Chatbot · Interactive Mini-Games · Bilingual Tests
                    </div>
                  </div>

                  {/* ── Step cards ── */}
                  <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                    {flyerSteps.map((s, si) => (
                      <div key={si} style={{ border: `1.5px solid ${s.color}28`, borderRadius: 10, overflow: "hidden" }}>

                        {/* Card title bar */}
                        <div style={{
                          background: s.bg, padding: "9px 14px",
                          display: "flex", alignItems: "center", gap: 9,
                          borderBottom: `1px solid ${s.color}20`,
                        }}>
                          <span style={{ fontSize: 17 }}>{s.icon}</span>
                          <div style={{ fontWeight: 700, fontSize: 13, color: s.color }}>
                            <span style={{
                              display: "inline-block", background: s.color, color: "white",
                              borderRadius: 20, fontSize: 10, fontWeight: 800,
                              padding: "1px 7px", marginRight: 6,
                            }}>Step {si + 1}</span>
                            {s.title}
                          </div>
                        </div>

                        {/* Step list */}
                        <div style={{ padding: "10px 14px 12px", background: "#fff" }}>
                          {s.steps.map((step, i) => (
                            <div key={i} style={{ display: "flex", alignItems: "flex-start", gap: 9, marginBottom: i < s.steps.length - 1 ? 7 : 0 }}>
                              <div style={{
                                minWidth: 19, height: 19, borderRadius: "50%",
                                background: s.color, color: "white",
                                fontSize: 10, fontWeight: 800,
                                display: "flex", alignItems: "center", justifyContent: "center",
                                flexShrink: 0, marginTop: 2,
                              }}>{i + 1}</div>
                              <div style={{ fontSize: 12.5, color: "#3a3a3a", lineHeight: 1.6 }}>{step}</div>
                            </div>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>

                  {/* ── Pro tip ── */}
                  <div style={{
                    marginTop: 12, padding: "11px 14px",
                    background: "#fffbea", borderRadius: 8,
                    border: "1px solid #f3d23e",
                    fontSize: 12, color: "#7a6200", lineHeight: 1.65,
                    display: "flex", gap: 8, alignItems: "flex-start",
                  }}>
                    <span style={{ fontSize: 15, flexShrink: 0 }}>💡</span>
                    <span>
                      <strong>Pro tip:</strong> Open a lesson → read in Vietnamese first → flip to English → finish with the Mini-game.
                      That 3-step loop is the fastest way to lock in bilingual math vocabulary.
                    </span>
                  </div>

                  {/* ── CTA buttons ── */}
                  <div style={{ display: "flex", gap: 10, marginTop: 14 }}>
                    <Link href="/cacbailam" style={{ flex: 1, textDecoration: "none" }} onClick={() => setShowFlyer(false)}>
                      <div style={{
                        background: "#0B4F5C", color: "white", borderRadius: 8,
                        padding: "10px 0", textAlign: "center",
                        fontWeight: 700, fontSize: 13, cursor: "pointer",
                        transition: "opacity 0.15s",
                      }}>
                        📖 Bắt đầu học
                      </div>
                    </Link>
                    <Link href="/DuoMCB" style={{ flex: 1, textDecoration: "none" }} onClick={() => setShowFlyer(false)}>
                      <div style={{
                        background: "#f9f9f9", color: "#0B4F5C",
                        border: "1.5px solid #0B4F5C",
                        borderRadius: 8, padding: "10px 0", textAlign: "center",
                        fontWeight: 700, fontSize: 13, cursor: "pointer",
                      }}>
                        🤖 Hỏi DuoMCB
                      </div>
                    </Link>
                  </div>
                </div>
              )}
            </div>
            {/* ── END HOW TO USE ── */}

            {/* Học toán */}
            <Link href="/Cacbailam" style={{ textDecoration: "none", color: "black", boxShadow: "0 4px 12px rgba(0,0,0,0.1)", padding: "12px 12px", borderRadius: 8, background: "white" }}>
              Học toán ›
            </Link>

            {/* Đăng nhập */}
            <Link href="/signup">
              <button style={{ background: "black", color: "white", border: "none", borderRadius: 8, padding: "10px 18px", fontWeight: 600, cursor: "pointer" }}>
                Đăng nhập
              </button>
            </Link>

            {/* Avatar accordion */}
            <div style={{ position: "relative", display: "flex", alignItems: "center", background: "white" }}>
              <Accordion selectionMode="multiple" style={{ width: "100%", paddingTop: 10, paddingBottom: 10, paddingLeft: 10, display: "flex", flexDirection: "column", minWidth: 45, boxShadow: "0 4px 12px rgba(0,0,0,0.1)", overflowX: "unset", justifyContent: "space-around", color: "white" }} variant="shadow" colorScheme="primary" defaultValue={["1"]}>
                <AccordionItem key="1" aria-label="User" startContent={
                  <Avatar isBordered color="primary" src="/images/defaultuser.png" style={{ width: 36, height: 36, borderRadius: "50%", flexShrink: 0 }} />
                } variant="shadow">
                  <div style={{ position: "absolute", top: "calc(100% + 8px)", right: 0, zIndex: 500, minWidth: 260, boxShadow: "0 8px 24px rgba(0,0,0,0.15)", padding: 20, borderRadius: 10, background: "#f9f9f9" }}>
                    <div style={{ padding: 12, borderBottom: "1px solid #eee", color: "black" }}>
                      <strong>Personal info</strong>
                    </div>
                    <div style={{ padding: 12, borderBottom: "1px solid #eee", color: "#555" }}>{content}</div>
                    <div style={{ padding: 12, borderBottom: "1px solid #eee", color: "black" }}>
                      <strong>Recent activities</strong>
                    </div>
                    <div style={{ padding: 12, borderBottom: "1px solid #eee", color: "#555" }}>{content2}</div>
                    <div style={{ padding: 12, cursor: "pointer", color: "#c00" }} onClick={() => {}}>Sign out</div>
                  </div>
                </AccordionItem>
              </Accordion>
            </div>

          </nav>
        </header>

        {/* ================= HERO ================= */}
        <div className="reveal" data-reveal data-reveal-stagger data-stagger="120"
          style={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: 40, paddingTop: 20, flexWrap: "wrap" }}>

          <img src="/images/duosteamicon.png" data-avatar-trigger
            style={{ width: "520px", maxWidth: "100%", cursor: "pointer" }} />

          <div className="reveal" data-reveal data-reveal-stagger data-stagger="60"
            style={{ maxWidth: "520px", boxShadow: "0 4px 12px rgba(0,0,0,0.1)", padding: 20, borderRadius: 10, background: "#f9f9f9" }}>
            <h1 style={{ fontSize: 40, marginBottom: 10, color: "black" }}>
              Welcome to DUOMATH!
            </h1>
            <p style={{ color: "#777", fontSize: 22, marginBottom: 20 }}>
              Broaden your mathematical horizons with <strong>DUOMATH</strong> - the ultimate <strong>bilingual math resource</strong> for high school students!
            </p>
            <p style={{ color: "#777", fontSize: 18, lineHeight: 1.6, marginBottom: 25 }}>
              At <strong>DUOMATH</strong>, we believe the future of <strong>STEM</strong> is <strong>bilingual</strong>. Dive into an immersive learning experience with high-school-aligned resources that help you solve complex problems in two languages. Your journey to academic excellence starts here.
            </p>
            <button style={{ padding: "16px 28px", background: "black", color: "white", borderRadius: 10, border: "none", fontSize: 18, fontWeight: 600, cursor: "pointer" }}>
              Start
            </button>
          </div>
        </div>

        {/* ================= TITLE ================= */}
        <div className="reveal" data-reveal data-reveal-stagger data-stagger="60"
          style={{ marginTop: 70, marginBottom: 30, display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          <h2 style={{ fontSize: 28 }}>Latest tests</h2>
          <Link href="/cacbailam" style={{ color: "#999" }}>Xem tất cả</Link>
        </div>

        {/* ================= GRID ================= */}
        <div className="reveal" data-reveal data-reveal-stagger data-stagger="100"
          style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(300px, 1fr))", gap: 40, marginBottom: 60, transition: "all 0.3s ease", boxShadow: "0 4px 12px rgba(0,0,0,0.1)", padding: 20, borderRadius: 10, background: "#f9f9f9" }}>

          <Link href="/section1-L10" style={{ textDecoration: "none", color: "inherit" }} onClick={() => clearTestSession("reading-test-1")}>
            <article>
              <img src="/images/math10.png" style={{ width: "100%", height: 220, objectFit: "cover", borderRadius: 10, marginBottom: 14 }} />
              <div style={{ fontSize: 22, fontWeight: 600 }}>Test 1</div>
              <div style={{ color: "#777", fontSize: 18 }}>Grade 10</div>
              <div style={{ fontSize: 16 }}>15 questions • Shorts answer + T/F/NG</div>
            </article>
          </Link>

          <Link href="/section1-L10-2" style={{ textDecoration: "none", color: "inherit" }} onClick={() => clearTestSession("reading-test-2")}>
            <article>
              <img src="/images/math10.png" style={{ width: "100%", height: 220, objectFit: "cover", borderRadius: 10, marginBottom: 14 }} />
              <div style={{ fontSize: 22, fontWeight: 600 }}>Test 2</div>
              <div style={{ color: "#777", fontSize: 18 }}>Grade 10</div>
              <div style={{ fontSize: 16 }}>15 questions • Shorts answer + T/F/NG</div>
            </article>
          </Link>

          <article>
            <img src="/images/math11.png" style={{ width: "100%", height: 220, objectFit: "cover", borderRadius: 10, marginBottom: 14 }} />
            <div style={{ fontSize: 22, fontWeight: 600 }}>Test 1</div>
            <div style={{ color: "#777", fontSize: 18 }}>Grade 11 (coming soon)</div>
            <div style={{ fontSize: 16 }}>15 questions • Shorts answer + T/F/NG</div>
          </article>

          <article>
            <img src="/images/math12.png" style={{ width: "100%", height: 220, objectFit: "cover", borderRadius: 10, marginBottom: 14 }} />
            <div style={{ fontSize: 22, fontWeight: 600 }}>Test 1</div>
            <div style={{ color: "#777", fontSize: 18 }}>Grade 12 (coming soon)</div>
            <div style={{ fontSize: 16 }}>15 questions • Shorts answer + T/F/NG</div>
          </article>
        </div>

        {/* ================= CONTACT ================= */}
        <hr style={{ width: "5px" }}></hr>
        <h2 className="reveal" data-reveal data-reveal-stagger data-stagger="60" style={{ fontSize: 28, marginBottom: 20 }}>Contact</h2>
        <div className="reveal" data-reveal style={{ marginBottom: 60 }}>
          <Accordion selectionMode="multiple" variant="shadow" colorScheme="primary" defaultValue={["1"]} style={{ marginBottom: 20, padding: 20, borderRadius: 10, background: "#f9f9f9", width: "100%" }}>
            <AccordionItem key="1" aria-label="Contact Us" title="Contact Us">
              <div className="reveal" data-reveal data-reveal-stagger data-stagger="120">
                {defaultContents.map((line, idx) => (
                  <div key={idx} style={{ marginBottom: 4 }}>{line}</div>
                ))}
              </div>
            </AccordionItem>
          </Accordion>
        </div>

        <style jsx>{`
          .reveal {
            opacity: 0;
            transform: translateY(28px) scale(0.97);
            transition: opacity 0.55s cubic-bezier(.2,.8,.2,1), transform 0.45s cubic-bezier(.2,.8,.2,1);
            will-change: opacity, transform;
          }
          .reveal.visible { opacity: 1; transform: translateY(0) scale(1); }
          .reveal[data-reveal-stagger].visible { opacity: 1; transform: none; }
          .reveal[data-reveal-stagger] > * { opacity: 0; transform: translateY(24px) scale(0.97); will-change: opacity, transform; }
          header.reveal { transform: translateY(-18px); opacity: 0; }
          header.reveal.visible { opacity: 1; transform: translateY(0); }
          .avatar-accordion { opacity: 0; transform: translateY(-16px) scale(0.97); transition: opacity .45s cubic-bezier(.2,.8,.2,1), transform .4s cubic-bezier(.2,.8,.2,1); will-change: opacity, transform; }
          .avatar-accordion.avatar-visible { opacity: 1; transform: translateY(0) scale(1); }
          .avatar-dropdown { position: absolute; top: 55px; left: 50%; background: #fff; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); opacity: 0; transform: translateX(-50%) translateY(-10px) scale(0.96); visibility: hidden; pointer-events: none; transition: all .25s cubic-bezier(.2,.8,.2,1); z-index: 100; }
          .avatar-dropdown.avatar-visible { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); visibility: visible; pointer-events: auto; }
          article { transition: transform 0.25s cubic-bezier(.2,.8,.2,1), box-shadow 0.25s ease; border-radius: 10px; padding: 8px; }
          article:hover { transform: translateY(-6px) scale(1.01); box-shadow: 0 12px 28px rgba(0,0,0,0.12); }
        `}</style>

        <DuoMCBSidebar />
      </div>
    </div>
  );
}
